# --- SERVER CONFIGURATION ---
PORT=:8080
SERVICE_USER=daemon

# --- SECURITY & CORS ---
# Comma-separated list of origins. 
# Use '*' for development, or specific domains for production.
ALLOWED_ORIGINS=*

# --- WEB CLIENT ---
# Directory of the bundled web client served at "/" (default: ./web)
# WEB_DIR=/var/lib/ytdl-server/web

# --- STORAGE PATHS ---
DATA_DIR=/var/lib/ytdl-server
DOWNLOAD_DIR=/var/lib/ytdl-server/downloads
TEMP_DIR=/var/lib/ytdl-server/temp

# --- RESOURCE LIMITS ---
# Max simultaneous FFmpeg processes
MAX_CONCURRENT_JOBS=3

# --- MAINTENANCE ---
# Finished jobs and their files are removed after this many minutes; the
# janitor also runs at this interval. (Legacy name CLEAN_UP_MINUTES is still accepted.)
CLEAN_UP_AFTER_MINUTES=60